# ---------- Supabase (client-safe) : Dashboard > Project Settings > API ----------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key - safe to ship to the browser (Row Level Security protects the data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------- Supabase (server only) : never prefix these with NEXT_PUBLIC_ ----------
SUPABASE_URL=
# Secret / service_role key - bypasses RLS. Server code and scripts only.
SUPABASE_SECRET_KEY=
# Name of the PRIVATE bucket created by supabase/schema.sql
SUPABASE_BUCKET=payment-proofs

# ---------- Payment details shown on the registration form (optional, public) ----------
NEXT_PUBLIC_PAYMENT_ACCOUNT_TITLE=
NEXT_PUBLIC_PAYMENT_ACCOUNT_NUMBER=
NEXT_PUBLIC_PAYMENT_BANK=
